# ============================================================
# .env.example — Environment Variable Template
# ------------------------------------------------------------
# INSTRUCTIONS:
#   1. Copy this file into backend/.env
#   2. Fill in your actual MySQL password in DB_PASSWORD
#   3. Never commit the real .env file to Git
# ============================================================

# ── MySQL Connection ──────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=inventory_db

# ── FastAPI Server (optional overrides) ───────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
