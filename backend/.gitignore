# ============================================================
# .gitignore — Git Ignore Rules for Backend
# ============================================================

# ── Secrets / Environment ─────────────────────────────────────
.env
*.env
!.env.example

# ── Python virtual environment ────────────────────────────────
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyo

# ── IDE / OS files ────────────────────────────────────────────
.vscode/
.idea/
*.DS_Store
Thumbs.db

# ── Build / dist artifacts ────────────────────────────────────
dist/
build/
*.egg-info/

# ── Machine Learning Artifacts ────────────────────────────────
*.joblib
*.pkl
!saved_models/.gitkeep
